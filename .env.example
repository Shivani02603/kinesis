OPENAI_API_KEY=
# For Azure OpenAI, set OPENAI_BASE_URL to your resource's /openai/v1 endpoint
# and OPENAI_MODEL to your deployment name. Leave OPENAI_BASE_URL empty for
# the standard OpenAI API.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
# The factory graph is stored in SQLite (same app.db as everything else) — no
# graph database to run. Override the location only if you want it elsewhere.
# GRAPH_DB_PATH=
